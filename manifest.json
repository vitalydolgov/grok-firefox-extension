{
  "manifest_version": 3,
  "name": "Grok",
  "version": "1.0.0",
  "description": "Opens Grok in the Firefox sidebar. The built-in chatbot covers Claude, ChatGPT, Gemini, and Mistral; this adds Grok as a sidebar web view.",
  "browser_specific_settings": {
    "gecko": {
      "id": "grok-sidebar@grok-firefox.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_title": "Grok",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "open_at_install": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
